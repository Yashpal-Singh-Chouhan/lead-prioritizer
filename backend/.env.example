# Copy to backend/.env and fill in. Never commit the real .env file.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000
# Long random secret for signing login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_value
# Where the website runs: links in account emails point here
FRONTEND_URL=http://localhost:3000
# Account emails (verify email, reset password) are sent with Brevo's free HTTP API.
# Leave the key empty locally: emails are then printed in the server console instead.
BREVO_API_KEY=
# A sender address you verified in Brevo (Senders, domains & dedicated IPs > Senders)
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=Lead Prioritizer
